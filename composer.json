{
	"name": "nitecomm-code/woocommerce-product-category-shipping",
	"description": "WooCommerce shipping plugin that charges per product category with flat-rate or tiered-quantity rules, plus optional cart-wide Free Local Pickup for selected roles.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0+",
	"require": {
		"composer/installers": "^2.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcompatibility/php-compatibility": "^9.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"phpcompatibility/php-compatibility": true
		}
	},
	"scripts": {
		"cs": [
			"phpcs -n --standard=trunk/phpcs.xml --extensions=php includes/ product-category-shipping.php"
		],
		"cs-fix": [
			"phpcbf --standard=WordPress --extensions=php includes/ product-category-shipping.php"
		],
		"compatibility": [
			"phpcs -n --standard=trunk/phpcs.xml --extensions=php includes/ product-category-shipping.php"
		]
	},
	"autoload": {
		"psr-4": {
			"BT_Shipping\\": "includes/"
		}
	}
}
