<?xml version="1.0"?>
<ruleset name="Product Category Shipping">
    <description>WordPress Coding Standards with selective ignores for known false positives.</description>

    <!-- Exclude vendor, tests, node_modules -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- Run against PHP files -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>

    <!-- WordPress Core rules -->
    <rule ref="WordPress"/>

    <!--
        The text domain is product-category-shipping-for-woocommerce (WP.org slug).
        This rule is disabled because Plugin Check infers the expected domain from
        the installed folder name, which varies by environment.
    -->
    <rule ref="WordPress.WP.I18n.TextDomainMismatch">
        <severity>0</severity>
    </rule>

    <!--
        Known false positive: render_page() collects pre-escaped HTML into an
        output buffer then echoes it. Individual field values are escaped at
        render time (esc_html__, esc_attr__, etc.). The buffer itself is not
        user-supplied text and carries no injection risk.
    -->
    <rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
        <exclude-pattern>includes/class-pcsfw-admin.php</exclude-pattern>
    </rule>
</ruleset>
